{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/generate-shipping-invoices",
      "schedule": "0 8 1 * *"
    },
    {
      "path": "/api/cron/sweep-swap-deadlines",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/close-stale-support",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/cancel-unshipped",
      "schedule": "30 3 * * *"
    }
  ]
}
